{
  "$defs": {
    "CaptureEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Artifact",
          "type": "string"
        },
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        }
      },
      "required": [
        "artifact",
        "captured_at",
        "backend"
      ],
      "title": "CaptureEvidence",
      "type": "object"
    },
    "Display": {
      "additionalProperties": false,
      "properties": {
        "density": {
          "exclusiveMinimum": 0,
          "title": "Density",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "rotation": {
          "maximum": 3,
          "minimum": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "density",
        "rotation"
      ],
      "title": "Display",
      "type": "object"
    },
    "ForegroundApp": {
      "additionalProperties": false,
      "properties": {
        "activity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activity"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        }
      },
      "required": [
        "package"
      ],
      "title": "ForegroundApp",
      "type": "object"
    },
    "KeyboardState": {
      "additionalProperties": false,
      "properties": {
        "visible": {
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "visible"
      ],
      "title": "KeyboardState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture_skew_ms": {
      "minimum": 0,
      "title": "Capture Skew Ms",
      "type": "integer"
    },
    "display": {
      "$ref": "#/$defs/Display"
    },
    "foreground": {
      "$ref": "#/$defs/ForegroundApp"
    },
    "hierarchy": {
      "$ref": "#/$defs/CaptureEvidence"
    },
    "keyboard": {
      "$ref": "#/$defs/KeyboardState"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "screenshot": {
      "$ref": "#/$defs/CaptureEvidence"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "observation_id",
    "session_id",
    "revision",
    "display",
    "foreground",
    "keyboard",
    "hierarchy",
    "screenshot",
    "capture_skew_ms"
  ],
  "title": "RawObservation",
  "type": "object"
}
