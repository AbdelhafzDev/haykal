{
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "additionalProperties": true,
      "title": "Inputs",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "skill": {
      "pattern": "^[a-z0-9_.-]+$",
      "title": "Skill",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "skill",
    "version"
  ],
  "title": "RunRequest",
  "type": "object"
}
